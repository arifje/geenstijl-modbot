APP_NAME=ModBot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Local: docker compose up -d db
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=54329
DB_DATABASE=modbot
DB_USERNAME=modbot
DB_PASSWORD=modbot

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database

# --- Analysis (Claude) ---
ANTHROPIC_API_KEY=
MODBOT_LLM_MODEL=claude-opus-5-5
MODBOT_LLM_EFFORT=medium

# --- Window ---
MODBOT_WINDOW_HOURS=12
MODBOT_ARTICLE_LOOKBACK_HOURS=24
MODBOT_ONLY_APPROVED=true
# Europe/Amsterdam
MODBOT_REPORT_CRON="0 8,20 * * *"

# --- Slack ---
SLACK_ENABLED=true
SLACK_BOT_TOKEN=
SLACK_CHANNEL="#development"
SLACK_USERNAME=ModBot
SLACK_ICON_URL=

# --- Email (AhaSend) ---
AHASEND_ENABLED=true
AHASEND_API_KEY=
AHASEND_ACCOUNT_ID=
AHASEND_FROM_EMAIL=no-reply@platform.geenstijl.nl
AHASEND_FROM_NAME="GeenStijl Moderatierapport"
# Comma separated, optionally "Name <email>"
AHASEND_RECIPIENTS=
AHASEND_SANDBOX=false
