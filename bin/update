#!/usr/bin/env bash
#
# Update ModBot (Docker Compose) to the latest version, or to a given tag/branch.
#
#   bin/update            latest version of main
#   bin/update v1.6.2     a specific version
#
# The new image is built before anything is restarted: if the build fails,
# the running version keeps running. Migrations run automatically on start.

set -euo pipefail

cd "$(dirname "$0")/.."

TARGET="${1:-main}"
COMPOSE=(docker compose --profile app)

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*"; }
fail() { printf '\033[1;31m%s\033[0m\n' "$*"; exit 1; }

[ -f .env ] || fail "No .env found. See README.md → Installation."

if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    fail "There are local changes to tracked files; commit or discard them first (git status)."
fi

step "Fetching $TARGET"
OLD=$(git rev-parse --short HEAD)
git fetch --tags --quiet origin

if git show-ref --verify --quiet "refs/remotes/origin/$TARGET"; then
    git checkout --quiet "$TARGET" 2>/dev/null || git checkout --quiet -b "$TARGET" "origin/$TARGET"
    git merge --ff-only --quiet "origin/$TARGET"
else
    git checkout --quiet "$TARGET" || fail "Unknown version or branch: $TARGET"
fi

NEW=$(git rev-parse --short HEAD)
VERSION=$(git describe --tags --always)

if [ "$OLD" = "$NEW" ]; then
    echo "Already at $VERSION; rebuilding anyway."
else
    echo "Updating $OLD → $NEW ($VERSION):"
    git log --oneline --no-decorate "$OLD..$NEW" | sed 's/^/  /'
fi

step "Checking .env"
missing=$(comm -23 \
    <(grep -oE '^[A-Z_]+=' .env.example | sort -u) \
    <(grep -oE '^[A-Z_]+=' .env | sort -u) | tr -d '=')
if [ -n "$missing" ]; then
    warn "These settings from .env.example are not in your .env (defaults are used):"
    echo "$missing" | sed 's/^/  /'
else
    echo "OK"
fi

step "Building the image"
# --pull: always fetch the latest base images (PHP / Alpine security patches)
"${COMPOSE[@]}" build --pull

step "Restarting (migrations run first)"
"${COMPOSE[@]}" up -d

step "Waiting for the admin"
for _ in $(seq 1 30); do
    health=$("${COMPOSE[@]}" ps web --format '{{.Health}}' 2>/dev/null || true)
    [ "$health" = "healthy" ] && break
    sleep 3
done

"${COMPOSE[@]}" ps

if [ "$("${COMPOSE[@]}" ps -a migrate --format '{{.ExitCode}}' 2>/dev/null)" != "0" ]; then
    warn "Migrations failed:"
    "${COMPOSE[@]}" logs --tail 30 migrate
    exit 1
fi

if [ "${health:-}" != "healthy" ]; then
    warn "The admin is not healthy yet. Check: ${COMPOSE[*]} logs web"
    exit 1
fi

step "Cleaning up old ModBot images"
# Only this project's unused images; other projects on the server are left alone.
project="${COMPOSE_PROJECT_NAME:-$(basename "$PWD" | tr '[:upper:]' '[:lower:]')}"
docker image prune -f --filter "label=com.docker.compose.project=$project" | tail -1

step "Done: ModBot $VERSION is running"
grep -E '^APP_URL=' .env | sed 's/^APP_URL=/Admin: /;s/$/\/admin/' || true
